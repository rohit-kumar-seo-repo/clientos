// ClientOS — schema for Rohit's marketing/SEO agency client management.
// Multi-tenant-ready (every business-owned table carries organizationId)
// but V1 has exactly one Organization row and no org-switcher UI.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
}

enum ServiceStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ONE_TIME
}

// Full lifecycle from spec §8. Computed by the priority engine at read time
// from dueDate + payments, EXCEPT the terminal/manual ones (PAID is set by
// a trusted Razorpay webhook only; REFUNDED/CANCELLED are explicit actions).
enum BillingPeriodStatus {
  UPCOMING
  DUE
  DUE_TODAY
  OVERDUE
  PARTIALLY_PAID
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// Matches Razorpay's own payment entity states exactly.
enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  PROCESSED
  FAILED
}

// Matches Razorpay's own Payment Link states exactly. A link has no
// "FAILED" state of its own — individual attempts against it can fail
// (recorded as a FAILED Payment) without changing the link's own status.
enum PaymentLinkStatus {
  CREATED
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
}

// The collection instrument layered on top of BillingPeriod (the
// obligation). A BillingPeriod's own status stays date-driven; Invoice
// status is payment-driven and cascades down to its line items' periods
// once fully paid — see spec doc "Invoicing" section.
enum InvoiceStatus {
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum TaskStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum RecurrenceType {
  MONTHLY
  WEEKLY
  ONE_TIME
  CUSTOM
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

// One-time project lifecycle. Separate from recurring ServiceStatus.
enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

// Payment obligation status for project milestones and add-ons.
// V1: no partial payments — PENDING flips to PAID atomically.
enum MilestoneStatus {
  PENDING
  PAID
}

// Exactly the states listed in spec §19.
enum RenewalStatus {
  ACTIVE
  RENEWAL_UPCOMING
  RENEWAL_DISCUSSION
  RENEWED
  CANCELLED
  EXPIRED
}

enum ReminderTrigger {
  BEFORE_DUE
  AFTER_OVERDUE
}

enum ReminderChannel {
  EMAIL
  WHATSAPP
}

// AUTOMATIC sends immediately when scheduled (still gated by the org-level
// switch below). APPROVAL_REQUIRED creates a ReminderJob in PENDING_APPROVAL
// and never sends until an admin explicitly approves it (spec §15).
enum ReminderMode {
  AUTOMATIC
  APPROVAL_REQUIRED
}

enum ReminderJobStatus {
  SCHEDULED
  PENDING_APPROVAL
  APPROVED
  SENT
  SKIPPED
  FAILED
  CANCELLED
}

enum NotificationStatus {
  SENT
  FAILED
}

// =============================================================================
// ORG / AUTH — multi-tenant scaffold. V1: exactly one Organization, one (or
// a few) AdminUser rows, no invite flow, no roles/permissions.
// =============================================================================

model Organization {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings         OrganizationSettings?
  adminUsers       AdminUser[]
  clients          Client[]
  serviceTemplates ServiceTemplate[]
  webhookEvents    WebhookEvent[]
  reminderRules    ReminderRule[]
  auditLogs        AuditLog[]
  paymentLinks     PaymentLink[]

  @@map("organizations")
}

// The global safety switch from spec §14. Enforced server-side in the one
// code path allowed to call an email/WhatsApp provider — never a UI-only flag.
model OrganizationSettings {
  id                                  Int      @id @default(autoincrement())
  organizationId                      Int      @unique
  automaticClientCommunicationEnabled Boolean  @default(false)
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_settings")
}

// Sessions are DB-backed opaque tokens (not stateless JWTs) so a session can
// actually be revoked server-side.
model AdminUser {
  id                  Int       @id @default(autoincrement())
  organizationId      Int
  email               String    @unique @db.VarChar(191)
  passwordHash        String    @db.VarChar(255)
  name                String?   @db.VarChar(120)
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  // Login rate-limiting: incremented on each failed attempt, reset to 0 on
  // a successful login. lockedUntil is set once failedLoginAttempts crosses
  // the threshold and checked (in addition to, not instead of, the
  // password check) before any login is allowed to proceed.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  sessions            AdminSession[]
  auditLogs           AuditLog[]
  clientNotes         ClientNote[]
  clientActivity      ClientActivity[]
  refundsInitiated    Refund[]
  paymentsRecorded    Payment[]
  reminderApprovals   ReminderJob[]
  paymentLinksCreated PaymentLink[]

  @@index([organizationId])
  @@map("admin_users")
}

model AdminSession {
  id          Int      @id @default(autoincrement())
  token       String   @unique @db.VarChar(64)
  adminUserId Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@map("admin_sessions")
}

// Generic admin action trail (distinct from ClientActivity, which is the
// client-facing timeline specifically).
model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId Int
  adminUserId    Int?
  action         String   @db.VarChar(100)
  entityType     String   @db.VarChar(60)
  entityId       String   @db.VarChar(60)
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  adminUser    AdminUser?   @relation(fields: [adminUserId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// CLIENTS
// =============================================================================

model Client {
  id             Int          @id @default(autoincrement())
  organizationId Int
  businessName   String       @db.VarChar(150)
  contactPerson  String?      @db.VarChar(120)
  phone          String?      @db.VarChar(20)
  email          String?      @db.VarChar(191)
  website        String?      @db.VarChar(255)
  industry       String?      @db.VarChar(100)
  location       String?      @db.VarChar(150)
  status         ClientStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  contacts      ClientContact[]
  notes         ClientNote[]
  activity      ClientActivity[]
  services      ClientService[]
  invoices      Invoice[]
  renewals      Renewal[]
  reminderRules ReminderRule[]
  projects      Project[]
  paymentLinks  PaymentLink[]

  @@index([organizationId])
  @@index([status])
  @@map("clients")
}

model ClientContact {
  id        Int      @id @default(autoincrement())
  clientId  Int
  name      String   @db.VarChar(120)
  role      String?  @db.VarChar(80)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(191)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@map("client_contacts")
}

model ClientNote {
  id            Int      @id @default(autoincrement())
  clientId      Int
  authorAdminId Int?
  body          String   @db.Text
  createdAt     DateTime @default(now())

  client      Client     @relation(fields: [clientId], references: [id])
  authorAdmin AdminUser? @relation(fields: [authorAdminId], references: [id])

  @@index([clientId])
  @@map("client_notes")
}

// The chronological timeline from spec §7/§20. eventType is a free string
// (payment.received, task.completed, service.added, billing.amount_changed,
// reminder.sent, ...) rather than a giant enum — same pattern as the
// digital-products-bundle sibling project's *Event tables.
model ClientActivity {
  id           Int      @id @default(autoincrement())
  clientId     Int
  actorAdminId Int?
  eventType    String   @db.VarChar(60)
  summary      String   @db.VarChar(255)
  metadata     Json?
  createdAt    DateTime @default(now())

  client     Client     @relation(fields: [clientId], references: [id])
  actorAdmin AdminUser? @relation(fields: [actorAdminId], references: [id])

  @@index([clientId])
  @@map("client_activity")
}

// =============================================================================
// SERVICES & WORK — templates are reusable/editable (spec §17); task
// instances are generated per period and historical ones are never mutated
// (spec §18).
// =============================================================================

model ServiceTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String   @db.VarChar(120)
  description    String?  @db.VarChar(500)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  tasks          ServiceTemplateTask[]
  clientServices ClientService[]

  @@index([organizationId])
  @@map("service_templates")
}

model ServiceTemplateTask {
  id                Int            @id @default(autoincrement())
  serviceTemplateId Int
  title             String         @db.VarChar(150)
  recurrence        RecurrenceType @default(MONTHLY)
  sortOrder         Int            @default(0)
  isActive          Boolean        @default(true)

  serviceTemplate ServiceTemplate @relation(fields: [serviceTemplateId], references: [id])

  taskInstances TaskInstance[]

  @@index([serviceTemplateId])
  @@map("service_template_tasks")
}

// A client's subscription to a service. Billing is modeled per
// ClientService (not per Client) so a client with multiple services can
// have different fees/billing days per service, per spec §8's example.
model ClientService {
  id                Int           @id @default(autoincrement())
  clientId          Int
  serviceTemplateId Int
  feeInPaise        Int
  startDate         DateTime
  status            ServiceStatus @default(ACTIVE)
  endDate           DateTime?
  workStatus        WorkStatus    @default(NOT_STARTED)
  progressPercent   Int?
  workNote          String?       @db.VarChar(500)
  nextActionNote    String?       @db.VarChar(255)
  nextActionDate    DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client          Client          @relation(fields: [clientId], references: [id])
  serviceTemplate ServiceTemplate @relation(fields: [serviceTemplateId], references: [id])

  billingPlan       BillingPlan?
  taskInstances     TaskInstance[]
  reminderRules     ReminderRule[]
  serviceCategories ClientServiceCategory[]

  @@index([clientId])
  @@index([serviceTemplateId])
  @@map("client_services")
}

// Service-category tags on a ClientService. A package like
// "Google Ads + SEO Growth Package" can be tagged [Google Ads, Website SEO,
// Local SEO] so the Services page counts it under each category individually
// while the billing obligation stays a single ClientService / BillingPlan.
model ClientServiceCategory {
  id              Int      @id @default(autoincrement())
  clientServiceId Int
  category        String   @db.VarChar(100)
  createdAt       DateTime @default(now())

  clientService ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)

  @@index([clientServiceId])
  @@index([category])
  @@map("client_service_categories")
}

// Generated per period from ServiceTemplateTask; a completed September
// task is never edited when October's set is generated (spec §18).
model TaskInstance {
  id                    Int        @id @default(autoincrement())
  clientServiceId       Int
  serviceTemplateTaskId Int?
  title                 String     @db.VarChar(150)
  periodLabel           String     @db.VarChar(7) // "2026-09"
  dueDate               DateTime?
  status                TaskStatus @default(PENDING)
  completedAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  clientService       ClientService        @relation(fields: [clientServiceId], references: [id])
  serviceTemplateTask ServiceTemplateTask? @relation(fields: [serviceTemplateTaskId], references: [id])

  @@unique([clientServiceId, serviceTemplateTaskId, periodLabel])
  @@index([clientServiceId])
  @@index([status])
  @@map("task_instances")
}

// =============================================================================
// BILLING — proper period architecture (spec §8), not a single
// "next payment date" field. Historical periods/payments are never rewritten
// (spec §11/§36) — a fee change creates a new billing state going forward.
// =============================================================================

model BillingPlan {
  id              Int              @id @default(autoincrement())
  clientServiceId Int              @unique
  amountInPaise   Int
  currency        String           @default("INR") @db.VarChar(3)
  frequency       BillingFrequency @default(MONTHLY)
  billingDay      Int // day of month, 1-28
  startDate       DateTime
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  clientService ClientService @relation(fields: [clientServiceId], references: [id])

  billingPeriods BillingPeriod[]

  @@map("billing_plans")
}

model BillingPeriod {
  id            Int                 @id @default(autoincrement())
  billingPlanId Int
  periodLabel   String              @db.VarChar(7) // "2026-09"
  amountInPaise Int
  dueDate       DateTime
  status        BillingPeriodStatus @default(UPCOMING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  billingPlan BillingPlan @relation(fields: [billingPlanId], references: [id])

  // A period is billed via AT MOST one invoice line item (unique FK on the
  // other side) — this is what makes double-billing structurally
  // impossible rather than just policy. No direct Payment relation here:
  // payments are recorded against the Invoice, never the period directly.
  invoiceLineItem InvoiceLineItem?
  reminderJobs    ReminderJob[]
  paymentLinks    PaymentLink[]

  @@unique([billingPlanId, periodLabel])
  @@index([status])
  @@index([dueDate])
  @@map("billing_periods")
}

// INVOICE — the collection instrument. A BillingPeriod is the immutable,
// per-service *obligation* (never rewritten); an Invoice is what was
// actually presented for payment and can bundle one period (the default —
// auto-created when a period becomes due) or several periods across
// services for the same client (an explicit "combine into one invoice"
// admin action). totalAmountInPaise is a snapshot of its line items at
// creation time, not recomputed live, so an invoice's own history never
// silently changes.
model Invoice {
  id                 Int           @id @default(autoincrement())
  clientId           Int? // nullable: a client-less "new customer" Payment Link's invoice has no Client to attach to
  invoiceNumber      String        @unique @db.VarChar(20) // e.g. "INV-8F3K2Q" — the only reference ever shown to the client
  totalAmountInPaise Int
  currency           String        @default("INR") @db.VarChar(3)
  status             InvoiceStatus @default(DUE)
  dueDate            DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  client Client? @relation(fields: [clientId], references: [id])

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

// One row per obligation folded into an Invoice. Exactly one of
// (billingPeriodId, projectMilestoneId, projectAddOnId) must be non-null —
// enforced centrally in server-side creation logic, not the DB layer (MySQL
// has no partial CHECK support in older versions). The @unique on each FK
// column still guarantees no obligation is double-invoiced regardless.
//
// billingPeriodId is now nullable so project obligations can share this
// model without forcing Invoice/BillingPeriod coupling. Existing recurring
// rows all have billingPeriodId set and are unaffected by the nullable change.
model InvoiceLineItem {
  id                 Int      @id @default(autoincrement())
  invoiceId          Int
  billingPeriodId    Int?     @unique // recurring: one period ↔ one line item
  projectMilestoneId Int?     @unique // project milestone payment obligation
  projectAddOnId     Int?     @unique // project add-on payment obligation
  description        String?  @db.VarChar(255) // human label (e.g. "50% Advance")
  amountInPaise      Int
  createdAt          DateTime @default(now())

  invoice          Invoice           @relation(fields: [invoiceId], references: [id])
  // onDelete: Restrict preserves the production constraint (RESTRICT/CASCADE).
  // Prisma would default to SetNull for nullable FKs, which would change the
  // live constraint — we explicitly override it here.
  billingPeriod    BillingPeriod?    @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projectMilestone ProjectMilestone? @relation(fields: [projectMilestoneId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projectAddOn     ProjectAddOn?     @relation(fields: [projectAddOnId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// One row per Razorpay payment attempt on an INVOICE (a failed attempt
// followed by a successful retry is two rows). Never overwritten. Moved
// off BillingPeriod so one Razorpay payment can settle a combined invoice
// spanning multiple services/periods at once.
model Payment {
  id                Int           @id @default(autoincrement())
  invoiceId         Int
  recordedByAdminId Int?
  paymentLinkId     Int? // set when this payment came from a PaymentLink; null for manual/checkout-order payments
  razorpayOrderId   String?       @db.VarChar(60)
  razorpayPaymentId String?       @unique @db.VarChar(60)
  razorpaySignature String?       @db.VarChar(255)
  status            PaymentStatus @default(CREATED)
  amountInPaise     Int
  currency          String        @default("INR") @db.VarChar(3) // mirrors Invoice/BillingPlan's existing currency field
  method            String?       @db.VarChar(30)
  failureReason     String?       @db.VarChar(255)
  capturedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoice         Invoice      @relation(fields: [invoiceId], references: [id])
  recordedByAdmin AdminUser?   @relation(fields: [recordedByAdminId], references: [id])
  paymentLink     PaymentLink? @relation(fields: [paymentLinkId], references: [id])

  refunds Refund[]

  @@index([invoiceId])
  @@index([paymentLinkId])
  @@map("payments")
}

// A Razorpay Payment Link — the collection *request*, distinct from the
// Payment row(s) it may produce over its lifetime (zero, one, or several,
// for a partially-paid link). Deliberately does NOT create an Invoice at
// creation time: exactly like the manual "Mark Paid" path, an Invoice only
// ever comes into existence once money actually moves — a link, by itself,
// is never a financial obligation.
//
// Exactly one of (billingPeriodId, projectMilestoneId, projectAddOnId) is
// set for an obligation-backed link; all three null means a custom/ad-hoc
// link with no existing obligation — enforced centrally in server-side
// creation logic (payment-links.ts), same principle as InvoiceLineItem's
// own invariant. These FKs are deliberately NOT @unique (unlike
// InvoiceLineItem's): a link can expire or be cancelled and a fresh one
// issued for the same obligation, so "at most one *active* link per
// obligation" is an application-level check in payment-links.ts, not a DB
// constraint — old links are never deleted, only status-transitioned, so
// history stays intact.
model PaymentLink {
  id                      Int               @id @default(autoincrement())
  organizationId          Int // direct org scope — required so a client-less link (no Client to derive org from) is still org-isolated
  clientId                Int? // nullable: a "new customer" link with "save as client" unchecked has no Client
  billingPeriodId         Int?
  projectMilestoneId      Int?
  projectAddOnId          Int?
  razorpayPaymentLinkId   String            @unique @db.VarChar(60)
  razorpayShortUrl        String            @db.VarChar(255)
  description             String            @db.VarChar(255)
  amountInPaise           Int
  currency                String            @default("INR") @db.VarChar(3)
  allowsPartialPayment    Boolean           @default(false)
  minPartialAmountInPaise Int?
  isUpiOnly               Boolean           @default(false) // Razorpay's upi_link flag — a UPI-only link vs. the standard all-methods link
  expiresAt               DateTime?
  status                  PaymentLinkStatus @default(CREATED)
  createdByAdminId        Int?
  // The payer's identity as sent to Razorpay, persisted so the link/payment
  // stays identifiable even with no Client record (clientId null). Also
  // populated for client-based links, mirroring whatever was actually sent.
  customerName            String?           @db.VarChar(150)
  customerEmail           String?           @db.VarChar(191)
  customerPhone           String?           @db.VarChar(20)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  client           Client?           @relation(fields: [clientId], references: [id])
  billingPeriod    BillingPeriod?    @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projectMilestone ProjectMilestone? @relation(fields: [projectMilestoneId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projectAddOn     ProjectAddOn?     @relation(fields: [projectAddOnId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByAdmin   AdminUser?        @relation(fields: [createdByAdminId], references: [id])

  payments Payment[]

  @@index([organizationId])
  @@index([clientId])
  @@index([billingPeriodId])
  @@index([projectMilestoneId])
  @@index([projectAddOnId])
  @@map("payment_links")
}

model Refund {
  id                 Int          @id @default(autoincrement())
  paymentId          Int
  razorpayRefundId   String?      @unique @db.VarChar(60)
  amountInPaise      Int
  reason             String?      @db.VarChar(255)
  status             RefundStatus @default(REQUESTED)
  initiatedByAdminId Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  payment          Payment    @relation(fields: [paymentId], references: [id])
  initiatedByAdmin AdminUser? @relation(fields: [initiatedByAdminId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// Idempotency ledger (spec §10). A webhook is only ever processed once no
// matter how many times Razorpay (or a replay) delivers it.
model WebhookEvent {
  id              Int       @id @default(autoincrement())
  organizationId  Int
  razorpayEventId String    @unique @db.VarChar(60)
  eventType       String    @db.VarChar(60)
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?   @db.VarChar(500)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("webhook_events")
}

// =============================================================================
// ONE-TIME PROJECTS — separate from recurring ClientService/BillingPlan.
// A client can have both. Financial obligations go through the same
// Invoice → InvoiceLineItem → Payment path as recurring services; only the
// InvoiceLineItem FK column differs (projectMilestoneId / projectAddOnId
// instead of billingPeriodId).
// =============================================================================

model Project {
  id                Int           @id @default(autoincrement())
  clientId          Int
  title             String        @db.VarChar(200)
  description       String?       @db.VarChar(1000)
  status            ProjectStatus @default(NOT_STARTED)
  // baseAmountInPaise = original agreed project amount. Never changed when
  // add-ons are added — add-ons are tracked separately so the audit trail
  // is clear (original ₹30k + add-on ₹5k, not rewritten as ₹35k).
  baseAmountInPaise Int
  startDate         DateTime?
  endDate           DateTime?
  workNote          String?       @db.VarChar(500)
  nextActionNote    String?       @db.VarChar(255)
  nextActionDate    DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client     Client             @relation(fields: [clientId], references: [id])
  milestones ProjectMilestone[]
  addOns     ProjectAddOn[]

  @@index([clientId])
  @@map("projects")
}

// A payment obligation within a project. V1: no partial payments — PENDING
// flips atomically to PAID via the same transactional idempotency guard as
// markBillingPeriodPaid. Adding milestones to an existing project is allowed;
// sortOrder controls display sequence.
model ProjectMilestone {
  id            Int             @id @default(autoincrement())
  projectId     Int
  label         String          @db.VarChar(150) // e.g. "50% Advance"
  amountInPaise Int
  dueDate       DateTime?
  status        MilestoneStatus @default(PENDING)
  paidAt        DateTime?
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceLineItem InvoiceLineItem? // null until marked paid
  paymentLinks    PaymentLink[]

  @@index([projectId])
  @@map("project_milestones")
}

// An additional charge added after the original project quote. Amount is
// separate from baseAmountInPaise on the parent Project — total project value
// is computed as baseAmountInPaise + sum(addOns.amountInPaise).
model ProjectAddOn {
  id            Int             @id @default(autoincrement())
  projectId     Int
  description   String          @db.VarChar(255) // e.g. "Additional Landing Page"
  amountInPaise Int
  dueDate       DateTime?
  status        MilestoneStatus @default(PENDING)
  note          String?         @db.VarChar(500)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceLineItem InvoiceLineItem? // null until marked paid
  paymentLinks    PaymentLink[]

  @@index([projectId])
  @@map("project_add_ons")
}

// =============================================================================
// RENEWALS (spec §19)
// =============================================================================

model Renewal {
  id                     Int           @id @default(autoincrement())
  clientId               Int
  contractStart          DateTime
  contractDurationMonths Int?
  renewalDate            DateTime
  status                 RenewalStatus @default(ACTIVE)
  notes                  String?       @db.VarChar(500)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  reminderJobs ReminderJob[]

  @@index([clientId])
  @@index([renewalDate])
  @@map("renewals")
}

// =============================================================================
// REMINDERS (spec §12/§13/§15) — OFF by default. A rule only ever fires if
// BOTH this rule is enabled AND OrganizationSettings.automaticClientCommunicationEnabled
// is true; APPROVAL_REQUIRED mode additionally needs an explicit admin click.
// =============================================================================

model ReminderRule {
  id              Int             @id @default(autoincrement())
  organizationId  Int
  clientId        Int? // null = org-wide default rule
  clientServiceId Int? // null = applies to all of the client's services
  trigger         ReminderTrigger
  offsetDays      Int
  channel         ReminderChannel
  mode            ReminderMode    @default(APPROVAL_REQUIRED)
  isEnabled       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id])
  clientService ClientService? @relation(fields: [clientServiceId], references: [id])

  jobs ReminderJob[]

  @@index([organizationId])
  @@index([clientId])
  @@map("reminder_rules")
}

// A scheduled instance of a rule, generated against one billing period or
// one renewal (exactly one of the two is set).
model ReminderJob {
  id                Int               @id @default(autoincrement())
  reminderRuleId    Int
  billingPeriodId   Int?
  renewalId         Int?
  scheduledFor      DateTime
  channel           ReminderChannel
  status            ReminderJobStatus @default(SCHEDULED)
  approvedByAdminId Int?
  sentAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  reminderRule  ReminderRule   @relation(fields: [reminderRuleId], references: [id])
  billingPeriod BillingPeriod? @relation(fields: [billingPeriodId], references: [id])
  renewal       Renewal?       @relation(fields: [renewalId], references: [id])
  approvedBy    AdminUser?     @relation(fields: [approvedByAdminId], references: [id])

  notifications NotificationLog[]

  @@index([reminderRuleId])
  @@index([status])
  @@map("reminder_jobs")
}

// What was actually sent — audit trail + duplicate-send prevention. Empty
// unless a channel is wired AND the global switch is on.
model NotificationLog {
  id                Int                @id @default(autoincrement())
  reminderJobId     Int
  channel           ReminderChannel
  recipient         String             @db.VarChar(191)
  status            NotificationStatus
  providerMessageId String?            @db.VarChar(191)
  errorMessage      String?            @db.VarChar(500)
  sentAt            DateTime?
  createdAt         DateTime           @default(now())

  reminderJob ReminderJob @relation(fields: [reminderJobId], references: [id])

  @@index([reminderJobId])
  @@map("notification_logs")
}
