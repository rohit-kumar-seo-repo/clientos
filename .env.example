# Copy this file to .env (local dev) and configure real values in the
# hosting panel's environment-variable settings for production.
# NEVER commit a real .env file. NEVER put real secrets in this file.

# ---------------------------------------------------------------------------
# DATABASE (MySQL — Hostinger shared hosting only offers MySQL, no Postgres;
# verified live against the account. Same driver-adapter pattern as the
# digital-products-bundle sibling project.)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@localhost:3306/clientos_dev?ssl=false"

# ---------------------------------------------------------------------------
# RAZORPAY — this app's OWN keys. Never share with digital-products-bundle
# or any other project's Razorpay credentials.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# EMAIL (SMTP — reminder sends, direct SMTP like the sibling project)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ClientOS <notifications@rohitkumarseo.com>"

# ---------------------------------------------------------------------------
# WHATSAPP — leave blank until WhatsApp Business API access is provided.
# The reminder engine's WhatsApp channel is architected but stays unwired
# (never sends) while this is unset.
# ---------------------------------------------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# ADMIN SESSION
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV=development
