# Copy to .env.test for local test runs. Points at a SEPARATE database from
# .env's clientos_dev — tests truncate all tables between runs, never point
# this at clientos_dev.
DATABASE_URL="mysql://root:@localhost:3306/clientos_test?ssl=false"

# Dummy, non-secret values — tests mock the Razorpay SDK boundary rather
# than calling the real API. NEVER a real key.
RAZORPAY_KEY_ID="rzp_test_dummy0000000"
RAZORPAY_KEY_SECRET="dummy_test_key_secret"
RAZORPAY_WEBHOOK_SECRET="dummy_test_webhook_secret"
